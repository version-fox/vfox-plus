# Pinned versions of the tools that build and test the Flutter implementation.
# CI (.github/workflows/flutter.yml) and the sandbox (sandbox/sandbox.sh) both
# read this file, so it is the only place to change them.

# Flutter SDK, stable channel. The checksum is the one of the Linux release
# archive listed in releases_linux.json of the Flutter release storage.
FLUTTER_VERSION=3.47.5
FLUTTER_SHA256=2132e990f236f8d22e7c6314b29a191a95b10d7cbcfec9b4e2e303d996652cbb

# vfox used by the end-to-end tests. The checksum is the one of
# vfox_<version>_linux_x86_64.tar.gz in the checksums.txt of the release.
VFOX_VERSION=1.0.12
VFOX_SHA256=7d4a504bbec0cec1072eabd8c5ab680852ea70e971280eba006066bde378a9bd
