{
  "name": "vfox-plus-capacitor",
  "version": "0.1.0",
  "private": true,
  "description": "vfox-plus with Ionic and Capacitor, in an Electron shell.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/version-fox/vfox-plus.git",
    "directory": "capacitor"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "assets": "node tools/icon-font.mjs && node tools/licenses.mjs",
    "electron": "install-electron --no",
    "dev": "vite --mode development",
    "build": "vite build && node tools/build-electron.mjs dist/app",
    "build:e2e": "VFOX_PLUS_E2E=1 vite build --outDir dist/app-e2e/renderer && node tools/build-electron.mjs dist/app-e2e",
    "start": "npm run build && electron dist/app",
    "stage": "node tools/stage.mjs",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "@ionic/core": "^9.0.9",
    "@ionic/vue": "^9.0.9",
    "@m3e/web": "^2.10.2",
    "@material/material-color-utilities": "^0.4.0",
    "@tanstack/vue-virtual": "^3.13.48",
    "vue": "^3.5.44",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "electron": "45.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13",
    "ws": "^8.22.0"
  }
}
