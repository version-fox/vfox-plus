# Pinned versions of the tools that build and test the Flet implementation.
# CI (.github/workflows/flet.yml) and the sandbox read this file. Flet itself
# is pinned in pyproject.toml (with uv.lock) and m3e/pyproject.toml; the
# Flutter SDK of the extension in m3e/src/flutter/vfox_plus_m3e/pubspec.yaml.

# uv, installed from its release archive for x86_64 Linux.
UV_VERSION=0.13.5
UV_SHA256=f68d291c75783122dad58ab77def0e13f3233f358731db5d6d7e8715603b928f

# Flutter, which `flet build` needs: the release archive for x86_64 Linux
# and its checksum.
FLUTTER_VERSION=3.44.8
FLUTTER_SHA256=672089e001571a9fbb209a495c583580c0c6c73ef98999264ba07fa93ace332d

# vfox, for the end-to-end tests against the real vfox: the release archive
# for x86_64 Linux and its checksum.
VFOX_VERSION=1.0.13
VFOX_SHA256=7ad0a4c82c8173f09393e09abecc3e27468253bab5fe53ffbf58f2b12b3fc768
