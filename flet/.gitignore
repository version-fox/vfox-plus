# Build outputs and the virtual environment of uv.
/build/
/dist/
/.venv/
__pycache__/
/.coverage
/coverage.xml
/htmlcov/
/.mypy_cache/
/.ruff_cache/
/.pytest_cache/
*.egg-info/
# Generated by tools/prepare.py; see there.
/src/vfox_plus/resources/
/m3e/src/flutter/vfox_plus_m3e/fonts/
# Generated by the Flutter tools in the package of the extension.
# The lockfile is committed, like the Flutter implementation does: the sandbox
# and CI resolve the pinned dependencies from it.
/m3e/src/flutter/vfox_plus_m3e/.dart_tool/
/m3e/src/flutter/vfox_plus_m3e/.flutter-plugins-dependencies
/m3e/build/
# The application icon for `flet build`, generated from shared/packaging.
/src/assets/

# The toolchains for the sandbox image, downloaded by sandbox.sh.
/sandbox/.downloads/

# Crash dumps of the built application.
core.*
