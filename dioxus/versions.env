# Versions of the tools of the Dioxus implementation, read by sandbox/sandbox.sh
# and .github/workflows/dioxus.yml. Rust and rustup are those of the Tauri
# implementation (../tauri/versions.env), whose sandbox image this one extends,
# and Node.js is the one of the web front end (../web/versions.env).

# cargo-llvm-cov (Apache-2.0 OR MIT), for the coverage gate of core and state:
# the prebuilt release for x86_64 Linux and its checksum.
CARGO_LLVM_COV_VERSION=0.9.1
CARGO_LLVM_COV_SHA256=b3f68e625481fed9b16444174f3fa5ebcdbde4a1878803a35eabe2dcefcdc41a

# vfox, for the end-to-end tests against the real vfox: the release archive
# for x86_64 Linux and its checksum.
VFOX_VERSION=1.0.13
VFOX_SHA256=7ad0a4c82c8173f09393e09abecc3e27468253bab5fe53ffbf58f2b12b3fc768
