# Pinned versions of the tools that build and test the Wails implementation.
# CI (.github/workflows/wails.yml) and the sandbox read this file. Node.js
# comes from ../web/versions.env, because the front end is built there.

# Go. The checksum is the one of go<version>.linux-amd64.tar.gz on
# https://go.dev/dl/.
GO_VERSION=1.27.3
GO_SHA256=65efbc80fdc1fa2cd2631cad5b481777a68e8725f34e89f50fc6ac714e379b40

# golangci-lint, the linter and formatter of the Go code. The checksum is the
# one of golangci-lint-<version>-linux-amd64.tar.gz in the checksums of the
# release.
GOLANGCI_LINT_VERSION=2.15.0
GOLANGCI_LINT_SHA256=9b7fe6a6bf6334b98decf8d86b11415ea7889afdabdd1959fdce23af2a9ebcea

# vfox used by the end-to-end tests; the same as in ../web/versions.env.
VFOX_VERSION=1.0.13
VFOX_SHA256=7ad0a4c82c8173f09393e09abecc3e27468253bab5fe53ffbf58f2b12b3fc768
