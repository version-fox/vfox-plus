# Pinned versions of the tools that build and test the mygo implementation.
# CI (.github/workflows/mygo.yml) and the sandbox read this file.

# Go, installed from its release archive for x86_64 Linux. The checksum is
# the one of go<version>.linux-amd64.tar.gz published with the release.
GO_VERSION=1.27.3
GO_SHA256=65efbc80fdc1fa2cd2631cad5b481777a68e8725f34e89f50fc6ac714e379b40

# golangci-lint, installed from its release archive for x86_64 Linux.
GOLANGCI_LINT_VERSION=2.15.0
GOLANGCI_LINT_SHA256=9b7fe6a6bf6334b98decf8d86b11415ea7889afdabdd1959fdce23af2a9ebcea

# vfox, for the end-to-end tests against the real vfox: the release archive
# for x86_64 Linux and its checksum.
VFOX_VERSION=1.0.13
VFOX_SHA256=7ad0a4c82c8173f09393e09abecc3e27468253bab5fe53ffbf58f2b12b3fc768

# Node.js LTS, for the test server of the end-to-end tests against the real
# vfox. The checksum is the one of node-v<version>-linux-x64.tar.xz in the
# SHASUMS256.txt of the release.
NODE_VERSION=24.22.1
NODE_SHA256=6c172a9ab6718f7b801fb5a7bd486af2ee5e32758086a04b84fcce2aa77095e6
