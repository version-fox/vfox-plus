# Pinned versions of the tools that build the phone app (mygo/phone) for Android.
# CI (.github/workflows/phone.yml and release.yml), the dev container
# (.devcontainer/Dockerfile) and its check (.github/workflows/devcontainer.yml) read
# this file. The framework itself is the mygo module of mygo/go.mod, which pins the
# same version: keep MYGO_VERSION and that require in step.

# The mygo CLI, installed with go install from the release of the framework
# (github.com/egoist/mygo/cmd/mygo), without its leading v.
MYGO_VERSION=0.10.0

# Java, which Gradle runs on for the Android project that mygo writes: the project
# needs JDK 17, and Gradle 8.14.3 does not run on newer JDKs. CI uses Temurin, and the
# dev container the OpenJDK of the Ubuntu archive.
JAVA_VERSION=17

# The command-line tools of the Android SDK (sdkmanager), the zip for Linux that
# Google publishes: the build number in the name of the file, and its checksum. Only
# the dev container installs them; CI gets its own from android-actions/setup-android.
ANDROID_CMDLINE_TOOLS_BUILD=16111833
ANDROID_CMDLINE_TOOLS_SHA256=0877a1d048fe4a24efe2eff536ca4223f7adeb58648bb81909d33c446918cfa8

# The packages of the Android SDK that the build uses: the platform of compileSdk and
# targetSdk, the build tools (aapt2 and apksigner), and the NDK, whose clang compiles
# the Go code of the app for each ABI. The dev container installs them, so that its
# build downloads no package of the SDK; in CI the setup action does.
ANDROID_SDK_PLATFORM=36
ANDROID_SDK_BUILD_TOOLS=36.0.0
ANDROID_NDK_VERSION=28.2.13676358

# The build tools that the Android Gradle plugin asks for, besides the ones above: its
# default for its version (8.12.0, in the project that mygo writes), which an app of mygo
# cannot change. The plugin downloads a package that is missing in the middle of the build,
# and that fails where the SDK is not writable, as in the dev container, so every place
# that installs the SDK installs these too.
ANDROID_GRADLE_BUILD_TOOLS=35.0.0

# The emulator that phone.yml starts: its API level, and the system image of the
# Google APIs for x86_64 that it runs.
ANDROID_EMULATOR_API=36
ANDROID_SYSTEM_IMAGE_TARGET=google_apis
