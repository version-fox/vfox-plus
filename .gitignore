# Operating system and editor files.
.DS_Store
Thumbs.db
*.swp
*~

# Visual Studio Code settings are personal.
.vscode/

# IntelliJ IDEA project files are personal, in every directory.
.idea/
*.iml

# Packaging output (see `vfxtool build-deb`).
/dist/

# Signing keys never belong to the repository (see docs/en/dev/packaging-android.md#signing-status).
*.jks
*.keystore

# Snapcraft inputs and outputs (see snap/snapcraft.yaml).
snap/*.snap
snap/vfox-plus.deb

# The phone app (mygo/phone): the icons that `vfxtool appicon` writes before a build (the repository
# holds no binary files), and the outputs and the generated Gradle project of `mygo build`.
/mygo/phone/resources/icon.png
/mygo/phone/resources/icon-foreground.png
/mygo/phone/dist/
/mygo/phone/.mygo/
