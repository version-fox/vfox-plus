*.keystore

# Snapcraft inputs and outputs (see snap/snapcraft.yaml).
snap/*.snap
snap/vfox-plus.deb

# Android build outputs (see docs/en/dev/packaging-android.md).
/android/.gradle/
/android/.kotlin/
/android/build/
/android/app/build/
/android/local.properties
