# Pinned versions of the tools that build the Android remote client.
# CI (.github/workflows/android.yml) and the dev container
# (.devcontainer/Dockerfile) read this file. The plugin and library
# versions below are also pinned in android/build.gradle.kts and
# android/app/build.gradle.kts; keep them in sync. Gradle itself is pinned,
# with its checksum, in android/gradle/wrapper/gradle-wrapper.properties.

# Java, installed from a Temurin release archive for x86_64 Linux. The dev
# container installs the OpenJDK of this version from the Ubuntu archive.
JAVA_VERSION=17

# The command-line tools of the Android SDK (sdkmanager), the zip for Linux
# that Google publishes: the build number in the name of the file, and its
# checksum. Only the dev container installs them; CI gets its own from
# android-actions/setup-android, whose default build moves with the action. This
# one (16.0) is the build that the dev container was tried with. In 23.0, the
# newest at the time of writing, sdkmanager is a stand-in for the new Android CLI,
# which it downloads on its first run, and it says that --licenses is no longer
# needed: the dev container has not been tried with that.
ANDROID_CMDLINE_TOOLS_BUILD=12266719
ANDROID_CMDLINE_TOOLS_SHA256=3fab261d5219d582321db0c5670b3bbafd563096bce3f6277eb358807fc15f6e

# The packages of the Android SDK that the build uses: the platform of compileSdk
# in android/app/build.gradle.kts, and the build tools that the Android Gradle
# plugin asks for. The dev container installs them, so that its first build
# downloads no package of the SDK; in CI the plugin downloads them.
ANDROID_SDK_PLATFORM=36
ANDROID_SDK_BUILD_TOOLS=35.0.0

# Android Gradle plugin, in android/build.gradle.kts.
AGP_VERSION=8.13.2

# Kotlin Gradle plugin, in android/build.gradle.kts.
KOTLIN_VERSION=2.1.20

# Material library (Material 3 Expressive), in android/app/build.gradle.kts.
MATERIAL_VERSION=1.14.0
