# Pinned versions of the tools that build the Android remote client.
# CI (.github/workflows/android.yml) reads this file. The plugin and library
# versions below are also pinned in android/build.gradle.kts and
# android/app/build.gradle.kts; keep them in sync.

# Gradle, the distribution CI installs.
GRADLE_VERSION=9.5.1

# Java, installed from a Temurin release archive for x86_64 Linux.
JAVA_VERSION=17

# Android Gradle plugin, in android/build.gradle.kts.
AGP_VERSION=8.13.2

# Kotlin Gradle plugin, in android/build.gradle.kts.
KOTLIN_VERSION=2.1.20

# Material library (Material 3 Expressive), in android/app/build.gradle.kts.
MATERIAL_VERSION=1.14.0
