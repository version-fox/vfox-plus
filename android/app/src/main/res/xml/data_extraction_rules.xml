<!--
  Android 12 and later read these rules for the cloud backup and for the transfer
  to another device (and for adb backup); allowBackup="false" covers the older ones.
  Nothing of the app is copied: the session cookie is the credential of the pairing,
  and the settings are small enough to set again.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
