        <item name="colorOnSecondaryFixedVariant">@color/m3_on_secondary_fixed_variant</item>
        <item name="colorTertiary">@color/m3_tertiary</item>
        <item name="colorOnTertiary">@color/m3_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/m3_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/m3_on_tertiary_container</item>
        <item name="colorTertiaryFixed">@color/m3_tertiary_fixed</item>
        <item name="colorTertiaryFixedDim">@color/m3_tertiary_fixed_dim</item>
        <item name="colorOnTertiaryFixed">@color/m3_on_tertiary_fixed</item>
        <item name="colorOnTertiaryFixedVariant">@color/m3_on_tertiary_fixed_variant</item>
        <item name="colorError">@color/m3_error</item>
