# Normalise line endings to LF in the repository and in working trees,
# regardless of the local core.autocrlf setting.
* text=auto eol=lf

# Binary assets.
*.png binary
*.ttf binary
*.otf binary
*.ico binary

# Generated files, collapsed in code review diffs.
shared/fixtures/** linguist-vendored=true
