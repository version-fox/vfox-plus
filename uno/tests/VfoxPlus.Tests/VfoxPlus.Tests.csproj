<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>VfoxPlus.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <!-- The outputs of the JavaScript libraries that the C# ports are tested against. -->
    <None Include="Design\testdata\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\VfoxPlus.Core\VfoxPlus.Core.csproj" />
    <ProjectReference Include="..\..\src\VfoxPlus.State\VfoxPlus.State.csproj" />
    <ProjectReference Include="..\..\src\VfoxPlus.Design\VfoxPlus.Design.csproj" />
    <ProjectReference Include="..\..\src\VfoxPlus.Platform\VfoxPlus.Platform.csproj" />
  </ItemGroup>
</Project>
