# Pinned versions of the tools that build and test the Uno implementation.
# CI (.github/workflows/uno.yml) and the sandbox read this file. The version of
# Uno itself is that of the Uno.Sdk in global.json.

# The .NET SDK, installed from its release archive for x86_64 Linux. The version
# is the one in global.json; the checksum is the SHA-512 that the release
# metadata (https://builds.dotnet.microsoft.com/dotnet/release-metadata/10.0/releases.json)
# publishes for dotnet-sdk-<version>-linux-x64.tar.gz.
DOTNET_VERSION=10.0.402
DOTNET_SHA512=1904a98dda2db34ba78ba3c4fb1b224455329af91c341d83547843c1839e112b04ae699ee92fa2449a8f62249196a938723078c0c60b9f65c88539d5687729c2

# vfox, for the end-to-end tests against the real vfox: the release archive
# for x86_64 Linux and its checksum.
VFOX_VERSION=1.0.13
VFOX_SHA256=7ad0a4c82c8173f09393e09abecc3e27468253bab5fe53ffbf58f2b12b3fc768
