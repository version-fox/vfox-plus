<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-desktop</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>
    <AssemblyName>VfoxPlus</AssemblyName>
    <Version>0.1.0</Version>
    <!-- CA1016: the Uno SDK writes no assembly version, which an executable does not need. -->
    <NoWarn>$(NoWarn);CA1016</NoWarn>
    <RootNamespace>VfoxPlus.App</RootNamespace>

    <ApplicationTitle>vfox+</ApplicationTitle>
    <ApplicationId>dev.vfox.VfoxPlus</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationPublisher>vfox-plus</ApplicationPublisher>
    <Description>A graphical front end for vfox.</Description>

    <UnoFeatures>
      SimpleTheme;
      SkiaRenderer;
    </UnoFeatures>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      The published application is ahead-of-time compiled, so that it starts in half a second, and trimmed to what it
      uses: 104 MB instead of 158 MB. Publishing needs a runtime identifier (see docs/architecture.md).
    -->
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <IlcGenerateMstatFile>true</IlcGenerateMstatFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(E2E)' == 'true'">
    <!-- The end-to-end agent (E2E/) runs a scenario inside the application: see docs/new-implementation.md. -->
    <DefineConstants>$(DefineConstants);E2E</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(E2E)' != 'true'">
    <Compile Remove="E2E\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VfoxPlus.Core\VfoxPlus.Core.csproj" />
    <ProjectReference Include="..\VfoxPlus.State\VfoxPlus.State.csproj" />
    <ProjectReference Include="..\VfoxPlus.Design\VfoxPlus.Design.csproj" />
    <ProjectReference Include="..\VfoxPlus.Platform\VfoxPlus.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The icon fonts, the translations and the licenses, which tools/prepare.sh generates. -->
    <Content Include="Assets\Fonts\*.ttf" />
    <Content Include="Assets\Generated\**\*" />
  </ItemGroup>
</Project>
