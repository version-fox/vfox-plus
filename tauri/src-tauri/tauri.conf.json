{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "vfox+",
  "mainBinaryName": "vfox-plus",
  "version": "0.1.0",
  "identifier": "dev.vfox.VfoxPlus",
  "build": {
    "frontendDist": "../../web/dist/tauri",
    "beforeBuildCommand": "npm --prefix ../web run build:tauri && python3 ../shared/tools/cargo_licenses.py --manifest-path src-tauri/Cargo.toml --output ../web/dist/tauri/licenses.txt --append"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "vfox+",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
