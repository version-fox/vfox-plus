# Pinned versions of the tools that build and test the Tauri implementation.
# CI (.github/workflows/tauri.yml) and the sandbox read this file. Node.js and
# vfox come from ../web/versions.env, because the front end is built there.

# Rust, installed with rustup. The checksum is the one of rustup-init
# (static.rust-lang.org/rustup/archive/<version>/x86_64-unknown-linux-gnu/rustup-init.sha256).
RUST_VERSION=1.99.1
RUSTUP_VERSION=1.29.2
RUSTUP_SHA256=5be191e8c70a5007074254cb74d78dbfdd25cd5a61c27de7b8e5410122ec24f4

# vfox used by the end-to-end tests; the same as in ../web/versions.env.
VFOX_VERSION=1.0.13
VFOX_SHA256=7ad0a4c82c8173f09393e09abecc3e27468253bab5fe53ffbf58f2b12b3fc768
