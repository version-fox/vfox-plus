# Pinned versions of the tools that build and test the web front end. CI
# (.github/workflows/web.yml, tauri.yml, wails.yml) and the sandboxes read
# this file, so it is the only place to change them.

# Node.js LTS. The checksum is the one of node-v<version>-linux-x64.tar.xz in
# the SHASUMS256.txt of the release.
NODE_VERSION=24.22.0
NODE_SHA256=cc2f601cee82d9a5a233302fe307abc600727035fd7d2c3a3571755989e95008

# vfox used by the end-to-end tests. The checksum is the one of
# vfox_<version>_linux_x86_64.tar.gz in the checksums.txt of the release.
VFOX_VERSION=1.0.13
VFOX_SHA256=7ad0a4c82c8173f09393e09abecc3e27468253bab5fe53ffbf58f2b12b3fc768
