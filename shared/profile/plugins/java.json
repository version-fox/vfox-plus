    "defaultSource": "open",
    "rules": [
      {
        "pattern": "^(?<version>.*?)(?:-(?<source>{sources}))?(?:-(?<flavor>fx))?$",
        "labels": {
          "fx": "JavaFX"
        }
      }
    ]
