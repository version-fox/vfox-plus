  "shorthands": [
    {
      "name": "21-tem",
      "meaning": {
        "en": "The newest Temurin 21",
        "zh": "最新的 Temurin 21"
      }
    },
    {
      "name": "21.0.8-tem",
      "meaning": {
        "en": "The newest build of Temurin 21.0.8",
        "zh": "Temurin 21.0.8 的最新构建"
      }
    },
    {
      "name": "temurin-21",
      "meaning": {
        "en": "The same as 21-tem, with the distribution first",
        "zh": "与 21-tem 相同，发行版写在前面"
      }
    },
    {
      "name": "21-zulu-fx",
      "meaning": {
        "en": "The newest Zulu 21 with JavaFX",
        "zh": "带 JavaFX 的最新 Zulu 21"
      }
    },
    {
      "name": "28.ea-open",
      "meaning": {
        "en": "The newest early-access build of OpenJDK 28; searches list releases only",
        "zh": "OpenJDK 28 的最新抢先体验版；搜索只列出正式版"
      }
    },
    {
      "name": "21",
      "meaning": {
        "en": "OpenJDK from jdk.java.net, which stops at 21.0.2",
        "zh": "jdk.java.net 上的 OpenJDK，21 只到 21.0.2"
      }
    }
  ],
  "variables": [
    {
      "key": "VFOX_JAVA_GITHUB_MIRROR",
      "label": {
        "en": "GitHub mirror",
        "zh": "GitHub 镜像"
      },
      "help": {
        "en": "Most distributions download from GitHub. A mirror address goes in front of the GitHub address, so it must take the full address after its own, as gh-proxy does.",
        "zh": "大多数发行版从 GitHub 下载。镜像地址会加在 GitHub 地址前面，所以镜像必须能接受完整的 GitHub 地址，如 gh-proxy。"
      },
      "kind": "url",
      "presets": [
        {
          "value": "https://gh-proxy.org/",
          "name": "gh-proxy"
        }
      ],
      "example": "https://gh-proxy.org/"
    }
  ],
  "legacyFiles": [
    ".sdkmanrc"
  ],
  "facets": [
    {
      "id": "support",
      "label": {
        "en": "Support",
        "zh": "支持"
      },
      "kind": "note",
      "values": [
        "LTS"
      ]
    },
    {
      "id": "flavor",
      "label": {
        "en": "Flavor",
        "zh": "类型"
      },
      "kind": "note",
      "values": [
        "JavaFX"
      ]
    }
  ],
  "guide": {
    "en": "Write <version>-<distribution>, such as 21.0.8-tem: the short name (tem) or the long one (temurin), and -fx after it for JavaFX. Without a distribution it is OpenJDK from jdk.java.net.",
    "zh": "写成 <版本>-<发行版>，如 21.0.8-tem：发行版用简称（tem）或全称（temurin），末尾加 -fx 表示带 JavaFX。不写发行版时是 jdk.java.net 的 OpenJDK。"
  },
  "tips": [
    {
      "en": "OpenJDK from jdk.java.net keeps only the newest releases: name a distribution for an older one.",
      "zh": "jdk.java.net 的 OpenJDK 只保留最新的版本：要装较旧的版本，请写上发行版。"
    },
    {
      "en": "Set VFOX_JAVA_JDKS_LINKS before installing to expose the JDK to Gradle and IntelliJ IDEA in ~/.jdks.",
      "zh": "安装前设置 VFOX_JAVA_JDKS_LINKS，可以把 JDK 暴露给 Gradle 与 IntelliJ IDEA（~/.jdks）。"
    }
  ],
