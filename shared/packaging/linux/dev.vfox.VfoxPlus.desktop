[Desktop Entry]
Type=Application
Name=vfox+
GenericName=SDK Version Manager
GenericName[zh_CN]=SDK 版本管理器
Comment=Install and switch SDK versions with vfox
Comment[zh_CN]=使用 vfox 安装和切换 SDK 版本
Exec=vfox-plus
Icon=dev.vfox.VfoxPlus
Terminal=false
Categories=Development;
Keywords=vfox;sdk;version;manager;nodejs;java;python;golang;
Keywords[zh_CN]=vfox;sdk;版本;管理;
StartupWMClass=dev.vfox.VfoxPlus
StartupNotify=true
