# The Kotlin style, which ktlint enforces through Spotless; the settings of
# ../.editorconfig apply to the other files.

[*.{kt,kts}]
indent_size = 4
max_line_length = 140
ktlint_code_style = ktlint_official
# Composable functions are named like the elements they show.
ktlint_function_naming_ignore_when_annotated_with = Composable
