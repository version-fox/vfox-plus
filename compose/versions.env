# Pinned versions of the tools that build and test the Compose Multiplatform
# implementation. CI (.github/workflows/compose.yml) and the sandbox read this
# file, so it is the only place to change them. The libraries are pinned in
# gradle/libs.versions.toml.

# Eclipse Temurin JDK. The release is the name on https://adoptium.net, and
# the checksum the one of the Linux x64 JDK archive of that release.
JDK_MAJOR=25
JDK_RELEASE=jdk-25.0.4.1+1
JDK_SHA256=dbb698396d478e7fa2b1e50f4103324b2a99b90569ee27c33f2261f9215cf41e

# Gradle; the build has no wrapper, whose JAR would be a committed binary. The
# checksum is the one of gradle-<version>-bin.zip.
GRADLE_VERSION=9.8.1
GRADLE_SHA256=dce76f55f8e251a3a1f130eb120f30b3d271de2b76c9b0729d316b5a1b6dc01f

# vfox used by the end-to-end tests. The checksum is the one of
# vfox_<version>_linux_x86_64.tar.gz in the checksums.txt of the release.
VFOX_VERSION=1.0.13
VFOX_SHA256=7ad0a4c82c8173f09393e09abecc3e27468253bab5fe53ffbf58f2b12b3fc768
